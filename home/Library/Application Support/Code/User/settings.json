{
  // ----- THEME & UI -----
  "workbench.colorTheme": "Tomorrow Night Blue",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.browser.openLocalhostLinks": false,

  // ----- EDITOR CONFIGURATION -----
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports.oxc": "explicit"
  },
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "editor.fontFamily": "FiraCode Nerd Font",
  "editor.fontLigatures": true,
  "editor.letterSpacing": 1,
  "editor.stickyScroll.enabled": true,
  "editor.inlineSuggest.enabled": true,
  "editor.semanticHighlighting.enabled": true,

  // ----- JUPYTER & NOTEBOOK CONFIGURATION -----
  "notebook.formatOnSave.enabled": true,
  "notebook.codeActionsOnSave": {
    "notebook.source.organizeImports.ruff": "explicit"
  },

  // ----- RUFF CONFIGURATION -----
  "ruff.nativeServer": "on",
  "ruff.lint.select": ["I"],
  "ruff.format.preview": true,

  // ----- EXPLORER & FILES -----
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.typegen.ts",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts, ${capture}.typegen.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml",
    "*.mts": "${capture}.typegen.ts",
    "*.cts": "${capture}.typegen.ts"
  },
  "files.associations": {
    ".env": "properties",
    ".env.*": "properties",
    ".Brewfile": "shellscript",
    ".Brewfile.local": "shellscript",
    ".zshrc.local": "shellscript",
    ".shopifyignore": "ignore"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    ".nox/": true,
    ".idea/": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
    "**/.obsidian": true
  },

  // ----- TERMINAL -----
  "terminal.integrated.inheritEnv": false,

  // ----- EXTENSIONS & TOOLS -----
  "git.autofetch": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "json": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "go.toolsManagement.autoUpdate": true,
  "cSpell.userWords": [
    "Choropleth",
    "conda",
    "dnis",
    "envup",
    "faceid",
    "firestore",
    "pydantic",
    "qrcode",
    "Somerville",
    "wavefile",
    "webchat",
    "Websockets"
  ],

  // ----- LANGUAGE SPECIFIC -----
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[html]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[shellscript]": {
    "editor.tabSize": 2
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[typescript]": {
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.tabSize": 2
  },
  "[liquid]": {
    "editor.defaultFormatter": "Shopify.theme-check-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "redhat.telemetry.enabled": true
}
