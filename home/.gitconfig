[user]
name = Dustin Michels
email = dustin7538@gmail.com

[core]
editor = vim
excludesfile = /Users/dustinmichels/.gitignore_global

[init]
defaultBranch = main

[credential]
helper = cache

[push]
autoSetupRemote = true

[alias]
ls = "!f() { me=$(git config user.name); git log --graph --all --color=always --date=relative --format=format:'%C(auto)%h %C(green)%ar%x09%C(reset)%s%C(auto)%d%C(dim) · %an%C(reset)' \"$@\" | sed -E -e 's/ years?(, [0-9]+ months?)? ago\\t/ yr\\t/; s/ months? ago\\t/ mo\\t/; s/ weeks? ago\\t/ wk\\t/; s/ days? ago\\t/ d\\t/; s/ hours? ago\\t/ hr\\t/; s/ minutes? ago\\t/ min\\t/; s/ seconds? ago\\t/ sec\\t/' -e 's/(\\x1b\\[32m)([0-9]+ [a-z]+)\\t/\\1\\2      \\t/; s/(\\x1b\\[32m)(.{6}) *\\t/\\1\\2  /' -e \"s/\\x1b\\[2m · $me\\x1b\\[m$//\" | less -RFX; }; f"
last = log -1 HEAD
co = checkout
br = branch
ci = commit
st = status
unstage = reset HEAD --

# Use ssh when connecting to github
[url "git@github.com:"]
insteadOf = https://github.com
