[user]
name = Dustin Michels
email = dustin7538@gmail.com

[core]
editor = vim
excludesfile = /Users/dustinmichels/.gitignore_global

[init]
defaultBranch = main

[credential]
helper = cache

[push]
autoSetupRemote = true

[alias]
ls = "!f() { me=$(git config user.name); git log --graph --abbrev-commit --decorate --all --color=always --date=relative --format=format:'%C(bold blue)%h %C(bold green)(%ar) %C(reset)%s - %C(magenta)%an%C(bold yellow)%d' \"$@\" | sed -E -e 's/ weeks? ago\\)/ wk ago)/; s/ hours? ago\\)/ hr ago)/; s/ seconds? ago\\)/ sec ago)/' -e \"s/(\\x1b\\[35m)$me(\\x1b)/\\1Me\\2/\" | less -RFX; }; f"
last = log -1 HEAD
co = checkout
br = branch
ci = commit
st = status
unstage = reset HEAD --

# Use ssh when connecting to github
[url "git@github.com:"]
insteadOf = https://github.com
